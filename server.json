{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonmak-ascent/hkex-filings",
  "title": "HKEx Filings",
  "description": "Live HKEx (Hong Kong Stock Exchange) regulatory filings for AI agents.",
  "version": "2.4.2",
  "websiteUrl": "https://hkex-listco-updates.ascent-partners.com/",
  "repository": {
    "url": "https://github.com/simonmak-ascent/hkex-filing-scraper",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://hkex-listco-updates.ascent-partners.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "hkex-filing-scraper",
      "version": "2.4.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "hkex-filing-scraper"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "hkex-scraper-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/simonmak-ascent/hkex-filing-scraper/main/docs/social_preview.png",
      "mimeType": "image/png"
    }
  ]
}
